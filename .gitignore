# CMake build trees (canonical: build/, build-asan/, build-tsan/ via presets;
# build-* covers ad-hoc audit/scratch trees, e.g. build-audit/)
/build/
/build-asan/
/build-tsan/
/build-*/
# Direct-compile scratch (used when cmake is unavailable; see WP-H report)
/out/
*.o
*.obj
# Generated bench output
**/plots/
**/summary.txt
# Python
__pycache__/
*.pyc

# Editor / LSP caches
/.cache/
.clangd/
